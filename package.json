{
  "name": "fanhua",
  "version": "1.0.0",
  "description": "繁花 — 点击页面绽放手绘小花的零依赖 JS 插件，内置 200 张花朵贴图。Every click blooms a hand-drawn flower.",
  "main": "dist/fanhua.js",
  "module": "dist/fanhua.mjs",
  "types": "./dist/fanhua.d.ts",
  "unpkg": "dist/fanhua.iife.js",
  "jsdelivr": "dist/fanhua.iife.js",
  "files": [
    "dist",
    "src",
    "img/flowers",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "test": "node scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.ts",
    "webp": "node scripts/webp.ts"
  },
  "keywords": [
    "click",
    "flower",
    "hand-drawn",
    "bloom",
    "sprite",
    "effect",
    "confetti"
